---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const dateA = a.data.date ?? a.data.createdTime ?? '';
  const dateB = b.data.date ?? b.data.createdTime ?? '';
  return dateB.localeCompare(dateA);
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog</title>
  </head>
  <body>
    <main>
      <h1>Blog</h1>
      <ul>
        {sortedPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              {post.data.title ?? post.id}
            </a>
            {post.data.date && <time datetime={post.data.date}> – {post.data.date}</time>}
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
