---
/**
 * カスタム見出しコンポーネント
 *
 * MDXの # 記法や ## 記法に対応するカスタムコンポーネント。
 * <Content components={{ h1: CustomHeading, h2: CustomHeading }} /> で渡す。
 */
interface Props {
	id?: string;
}
const { id } = Astro.props;
---

<h1 {id} class="custom-heading">
	<slot />
</h1>

<style>
	.custom-heading {
		font-size: 2.5rem;
		font-weight: bold;
		color: #6c40ce;
		border-bottom: 3px solid #6c40ce;
		padding-bottom: 0.25rem;
		margin-bottom: 1.5rem;
	}
</style>
