---
/**
 * <details color="gray_bg">
 *   <summary>Toggle title</summary>
 *   Children
 * </details>
 *
 * MDX の `components.details` にマッピングされる。
 * `components.summary` と組み合わせて使う。
 */
import { colorToCSS } from './colors';

interface Props {
	color?: string;
}

const { color } = Astro.props;
---

<details class="notion-toggle" style={colorToCSS(color)}>
	<slot />
</details>

<style>
	.notion-toggle {
		border-radius: 0.375rem;
		margin: 0.25rem 0;
	}
	/* summary 以外の子要素 (= コンテンツ) にパディングを追加 */
	.notion-toggle :global(> *:not(summary)) {
		padding: 0 1rem 0.5rem;
	}
</style>
